          </elementProp>
          <elementProp name="MODEL" elementType="Argument">
            <stringProp name="Argument.name">MODEL</stringProp>
            <stringProp name="Argument.value">${__P(model,claude-haiku-4-5)}</stringProp>
            <stringProp name="Argument.desc">Haiku for load tests, Sonnet/Opus for integration</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MAX_TOKENS" elementType="Argument">
            <stringProp name="Argument.name">MAX_TOKENS</stringProp>
            <stringProp name="Argument.value">512</stringProp>
            <stringProp name="Argument.desc">Max output tokens. Increase if stop_reason=max_tokens in logs.</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SYSTEM_PROMPT" elementType="Argument">
            <stringProp name="Argument.name">SYSTEM_PROMPT</stringProp>
            <stringProp name="Argument.value">You are a helpful customer service assistant. Answer concisely and accurately.</stringProp>
            <stringProp name="Argument.desc">The system prompt for the chatbot under test</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NUM_THREADS" elementType="Argument">
            <stringProp name="Argument.name">NUM_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(threads,5)}</stringProp>
            <stringProp name="Argument.desc">Concurrent users. Baseline=1, Load=10, Stress=25</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP_SECONDS" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP_SECONDS</stringProp>
            <stringProp name="Argument.value">${__P(rampup,30)}</stringProp>
            <stringProp name="Argument.desc">Seconds to add all threads. 0 for instant ramp-up.</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DURATION_SECONDS" elementType="Argument">
            <stringProp name="Argument.name">DURATION_SECONDS</stringProp>
            <stringProp name="Argument.value">${__P(duration,180)}</stringProp>
            <stringProp name="Argument.desc">Test duration in seconds after ramp-up completes.</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="P95_THRESHOLD_MS" elementType="Argument">
            <stringProp name="Argument.name">P95_THRESHOLD_MS</stringProp>
            <stringProp name="Argument.value">10000</stringProp>
            <stringProp name="Argument.desc">SLA gate: sample fails if response exceeds this ms</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROMPTS_CSV" elementType="Argument">
            <stringProp name="Argument.name">PROMPTS_CSV</stringProp>
            <stringProp name="Argument.value">scripts/chatbot-prompts.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RESULTS_DIR" elementType="Argument">
            <stringProp name="Argument.name">RESULTS_DIR</stringProp>
            <stringProp name="Argument.value">scripts/results</stringProp>
            <stringProp name="Argument.desc">Create this directory before first run: mkdir scripts\results</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
