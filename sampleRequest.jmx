      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Cleanup Results Files">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
// Reset accumulated stats from any prior run so next run starts fresh
props.remove(&quot;sphere_agg&quot;)
props.remove(&quot;sphere_results_dir&quot;)
props.remove(&quot;sphere_tokens&quot;)

// Delete old result files so each run starts with clean files (no cross-run appending)
def resultsDir = vars.get(&quot;RESULTS_DIR&quot;) ?: &quot;scripts/results&quot;
[&quot;summary.csv&quot;, &quot;aggregate.csv&quot;, &quot;errors.jtl&quot;].each { fname -&gt;
    def f = new File(&quot;${resultsDir}/${fname}&quot;)
    if (f.exists()) {
        f.delete()
        log.info(&quot;[SETUP] Deleted ${f.absolutePath}&quot;)
    }
}
log.info(&quot;[SETUP] Results directory clean: ${resultsDir}&quot;)
          </stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Chatbot Load Test — ${NUM_THREADS} Users">
