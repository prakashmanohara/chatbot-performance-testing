<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Claude Chatbot — Performance Test Framework">
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="CLAUDE_API_KEY" elementType="Argument">
            <stringProp name="Argument.name">CLAUDE_API_KEY</stringProp>
            <stringProp name="Argument.value">${__P(claude.api.key,REPLACE_WITH_YOUR_API_KEY)}</stringProp>
